#!/usr/bin/python3 -I
"""Helper privilegiado do VPN Tray (rodado via pkexec).

Uso:
  vpn-tray-helper add            (JSON no stdin: name, host, port, auth, username,
                                  password, realm, trusted_cert)
  vpn-tray-helper trust NAME HASH
  vpn-tray-helper remove NAME
  vpn-tray-helper policy require-password on|off
  vpn-tray-helper policy apply        (regrava a regra do polkit a partir da política)

Só grava em /etc/openfortivpn/NAME.conf (0600) e NAME.args (0644), com um
conjunto fechado de chaves — nada de pppd-plugin, user-agent arbitrário etc.
"""

import json
import os
import pwd
import re
import subprocess
import sys

CONF_DIR = "/etc/openfortivpn"
POLICY_DIR = "/etc/vpn-tray"
POLICY_FILE = os.path.join(POLICY_DIR, "policy.json")
RULE_TEMPLATE = "/usr/local/libexec/vpn-tray/50-vpn-tray.rules.in"
RULE_FILE = "/etc/polkit-1/rules.d/50-vpn-tray.rules"
USER_RE = re.compile(r"^[a-z_][a-z0-9_.-]{0,31}$")
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,31}$")
HOST_RE = re.compile(r"^[A-Za-z0-9.-]{1,253}$")
HASH_RE = re.compile(r"^[0-9a-f]{64}$")


def die(msg, code=2):
    print(msg, file=sys.stderr)
    sys.exit(code)


def clean(value, field):
    value = "" if value is None else str(value)
    if any(c in value for c in "\r\n\0"):
        die(f"campo inválido: {field}")
    return value.strip()


def check_name(name):
    if not NAME_RE.match(name or ""):
        die("nome inválido (use a-z, 0-9, - e _; até 32 caracteres)")
    return name


def write_file(path, content, mode):
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w") as f:
        f.write(content)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def cmd_add():
    data = json.load(sys.stdin)
    name = check_name(clean(data.get("name"), "name"))
    host = clean(data.get("host"), "host")
    if not HOST_RE.match(host):
        die("host inválido")
    port = data.get("port")
    try:
        port = 443 if port in (None, "") else int(port)
    except (TypeError, ValueError):
        die("porta inválida")
    if not 0 < port < 65536:
        die("porta inválida")
    auth = clean(data.get("auth") or "saml", "auth")
    if auth not in ("saml", "password"):
        die("autenticação inválida")
    username = clean(data.get("username"), "username")
    password = clean(data.get("password"), "password")
    realm = clean(data.get("realm"), "realm")
    cert = clean(data.get("trusted_cert"), "trusted_cert").lower().replace(":", "")
    if cert and not HASH_RE.match(cert):
        die("trusted-cert deve ser o SHA256 em hex (64 caracteres)")

    lines = ["# gerado pelo VPN Tray", f"host = {host}", f"port = {port}"]
    if auth == "password":
        if not username or not password:
            die("usuário e senha são obrigatórios nesse modo")
        lines += [f"username = {username}", f"password = {password}"]
    if realm:
        lines.append(f"realm = {realm}")
    if cert:
        lines.append(f"trusted-cert = {cert}")

    os.makedirs(CONF_DIR, mode=0o755, exist_ok=True)
    write_file(os.path.join(CONF_DIR, name + ".conf"), "\n".join(lines) + "\n", 0o600)
    write_args(name, host, port, auth)
    print(f"perfil {name} gravado")


def write_args(name, host, port, auth):
    extra = "--saml-login" if auth == "saml" else ""
    content = (
        "# lido pelo vpn-tray@.service e pelo app (sem segredos aqui)\n"
        f"EXTRA_ARGS={extra}\n"
        f"VPN_HOST={host}\n"
        f"VPN_PORT={port}\n"
        f"VPN_AUTH={auth}\n"
    )
    write_file(os.path.join(CONF_DIR, name + ".args"), content, 0o644)


def cmd_trust(name, digest):
    check_name(name)
    digest = digest.lower().replace(":", "")
    if not HASH_RE.match(digest):
        die("hash inválido")
    path = os.path.join(CONF_DIR, name + ".conf")
    if not os.path.exists(path):
        die("perfil não existe")
    with open(path) as f:
        content = f.read()
    if f"trusted-cert = {digest}" not in content:
        if content and not content.endswith("\n"):
            content += "\n"
        content += f"trusted-cert = {digest}\n"
        write_file(path, content, 0o600)
    print("certificado confiado")


def cmd_remove(name):
    check_name(name)
    subprocess.run(["systemctl", "stop", f"vpn-tray@{name}.service"], check=False)
    for ext in (".conf", ".args"):
        try:
            os.remove(os.path.join(CONF_DIR, name + ext))
        except FileNotFoundError:
            pass
    print(f"perfil {name} removido")


def load_policy():
    try:
        with open(POLICY_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def caller_user(policy):
    """Quem pediu: pkexec/sudo dizem o UID original."""
    for var in ("PKEXEC_UID", "SUDO_UID"):
        uid = os.environ.get(var)
        if uid and uid.isdigit() and int(uid) != 0:
            return pwd.getpwuid(int(uid)).pw_name
    return policy.get("user")


def render_rule(template, user, require_password):
    if not USER_RE.match(user or ""):
        die("usuário inválido para a regra do polkit")
    return (
        template.replace("@USER@", user)
        .replace("@CONNECT_RESULT@", "polkit.Result.AUTH_SELF" if require_password else "polkit.Result.YES")
        .replace("@CONNECT_MODE@", "pede a senha do usuário" if require_password else "sem senha")
    )


def cmd_policy(args):
    policy = load_policy()
    user = caller_user(policy)
    if args == ["apply"]:
        pass
    elif len(args) == 2 and args[0] == "require-password" and args[1] in ("on", "off"):
        policy["require_password_connect"] = args[1] == "on"
    else:
        die(__doc__)
    policy["user"] = user
    with open(RULE_TEMPLATE) as f:
        rule = render_rule(f.read(), user, bool(policy.get("require_password_connect")))
    os.makedirs(POLICY_DIR, mode=0o755, exist_ok=True)
    write_file(POLICY_FILE, json.dumps(policy, indent=2) + "\n", 0o644)
    write_file(RULE_FILE, rule, 0o644)
    print(
        "conectar agora pede senha" if policy.get("require_password_connect") else "conectar não pede senha"
    )


def main():
    if os.geteuid() != 0:
        die("precisa rodar como root (via pkexec)")
    args = sys.argv[1:]
    if args == ["add"]:
        cmd_add()
    elif len(args) == 3 and args[0] == "trust":
        cmd_trust(args[1], args[2])
    elif len(args) == 2 and args[0] == "remove":
        cmd_remove(args[1])
    elif args and args[0] == "policy":
        cmd_policy(args[1:])
    else:
        die(__doc__)


if __name__ == "__main__":
    main()
